{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check:boundaries": "node --test scripts/check-module-boundaries-tests.mjs && node scripts/check-module-boundaries.mjs",
    "check:styles": "node --test scripts/check-style-tokens-tests.mjs && node scripts/check-style-tokens.mjs src/app/research-workspace/research-document-workbench.css",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:api": "openapi-ts -i ../backend/openapi.json -o src/api/generated",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.82",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.105.0",
    "@tiptap/core": "^3.32.1",
    "@tiptap/markdown": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@xyflow/react": "^12.12.0",
    "@ybouane/liquidglass": "^1.0.3",
    "citeproc": "2.4.63",
    "cytoscape": "3.34.4",
    "docx": "^9.15.0",
    "elkjs": "^0.12.1",
    "marked": "^17.0.4",
    "prosemirror-changeset": "^2.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "^8.5.1",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.0"
  }
}
