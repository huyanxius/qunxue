# This file contains placeholders only. Copy the relevant values into
# backend/.env and frontend/.env.local; never commit either copied file.

# Backend: zero-config local mode. This is deterministic mock/model behavior,
# not a claim that a production model is connected.
QUNXUE_RUNTIME_MODE=mock
QUNXUE_DATABASE_URL=sqlite:///var/qunxue.db

# Backend: deployment administrator. Keep real credentials only in backend/.env
# or the deployment platform's secret environment.
# QUNXUE_ACCOUNT_INITIAL_ADMIN_EMAIL=admin@example.com
# QUNXUE_ACCOUNT_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-secret

# Backend: a non-empty API key automatically enables the real OpenAI-compatible
# runtime. The defaults are DeepSeek's endpoint and deepseek-v4-flash; override
# the endpoint or model only when your provider requires it.
# QUNXUE_MODEL_API_KEY=
# QUNXUE_MODEL_BASE_URL=
# QUNXUE_MODEL_NAME=

# Backend: release-bound retrieval. Both remote providers and the exact frozen
# models are required when retrieval is enabled; missing values stop retrieval.
QUNXUE_RETRIEVAL_INDEX_PATH=var/retrieval.db
QUNXUE_RETRIEVAL_EMBEDDING_BATCH_SIZE=32
QUNXUE_RETRIEVAL_MIN_RERANK_SCORE=0.01
QUNXUE_RETRIEVAL_MIN_LEXICAL_SCORE=0.12
QUNXUE_RETRIEVAL_RECALL_LIMIT=30
# QUNXUE_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# QUNXUE_EMBEDDING_API_KEY=
# QUNXUE_EMBEDDING_MODEL=Pro/BAAI/bge-m3
# QUNXUE_RERANKER_BASE_URL=https://api.siliconflow.cn/v1
# QUNXUE_RERANKER_API_KEY=
# QUNXUE_RERANKER_MODEL=Pro/BAAI/bge-reranker-v2-m3

# Frontend: leave empty for same-origin local development.
# VITE_API_BASE_URL=
